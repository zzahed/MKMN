# Hoist every dependency into node_modules/.pnpm/node_modules (the default) except type-fest.
# Mermaid's type declarations import type-fest without declaring it. Hoisting the copy
# from ONNX Runtime's dependency graph can pull unrelated types into the renderer's type check.
hoist-pattern[]=*
hoist-pattern[]=!type-fest

# Refuse to install on a Node.js older than package.json "engines" allows (see .node-version for the CI pin).
engine-strict=true
