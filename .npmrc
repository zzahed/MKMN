# Hoist every dependency into node_modules/.pnpm/node_modules (the default) except type-fest.
# mermaid's type declarations import type-fest without declaring it; the 0.13 copy that
# onnxruntime-node brings (global-agent > serialize-error) would then resolve and force the
# "esnext" library onto the renderer's type check.
hoist-pattern[]=*
hoist-pattern[]=!type-fest

# Refuse to install on a Node.js older than package.json "engines" allows (Node 26: pdf.js, and the network lock on generated code).
engine-strict=true
