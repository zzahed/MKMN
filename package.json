{
  "name": "mkmn",
  "version": "0.0.2",
  "description": "MKMN AI — Private AI, powered by your PC. Local-first AI workspace for Windows 11 ARM64 (Qualcomm Snapdragon X Elite / Hexagon NPU 45 TOPS).",
  "keywords": [
    "snapdragon",
    "npu",
    "hexagon",
    "qualcomm",
    "windows-on-arm",
    "arm64",
    "copilot-plus-pc",
    "llm",
    "local-llm",
    "on-device-ai",
    "offline-ai",
    "chatbot",
    "geniex",
    "gguf",
    "tauri"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:sidecar": "tsc -p tsconfig.sidecar.json",
    "build": "pnpm run build:renderer",
    "start": "pnpm run build:sidecar && tauri dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.sidecar.json --noEmit",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\Build-Windows.ps1",
    "licenses": "node scripts/licenses.cjs",
    "regen": "node scripts/generate-settings-schema.mjs && node scripts/generate-state-machines.mjs && node scripts/generate-feature-matrix.mjs && node scripts/build-xblocks.js && node scripts/vendor-icons.js",
    "regen:check": "node scripts/generate-settings-schema.mjs --check && node scripts/generate-state-machines.mjs --check && node scripts/generate-feature-matrix.mjs --check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "animate.css": "^4.1.1",
    "aos": "^2.3.4",
    "countup.js": "^2.10.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "katex": "^0.19.0",
    "lucide-static": "^1.62.0",
    "mermaid": "^11.4.1",
    "prettier": "^3.10.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.0.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@measured/puck": "^0.20.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "acorn": "8.19.0",
    "onnxruntime-node": "1.21.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sherpa-onnx-node": "1.13.8",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-win-arm64": "1.13.8",
    "sherpa-onnx-win-x64": "1.13.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "uuid": "^11.1.1",
      "minimatch": "^11.0.4",
      "katex": "^0.19.0"
    }
  }
}
